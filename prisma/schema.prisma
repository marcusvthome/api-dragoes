generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Dragao {
  id        Int      @id @default(autoincrement())
  nome      String
  apelido   String?
  imagem    String?
  cor       String
  cavaleiro String?
  especie   String
  status    String
  tamanho   String
  descricao String
  createdAt DateTime @default(now())
}